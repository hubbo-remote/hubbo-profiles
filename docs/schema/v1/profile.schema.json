{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/maddox/hubbo-profiles/main/docs/schema/v1/profile.schema.json",
  "title": "Hubbo device profile",
  "description": "The shape of a device profile: one device on one platform.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "source", "manufacturer", "model", "kind", "platform", "commands"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^(harmony:[0-9]{1,48}|(hubbo|user):[a-z0-9][a-z0-9.-]{0,47})$"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "source": { "enum": ["hubbo", "harmony", "user"] },
    "manufacturer": { "$ref": "#/$defs/displayName" },
    "model": { "$ref": "#/$defs/displayName" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$", "description": "A kind from kinds.json." },
    "platform": { "enum": ["ble_hid", "ir"] },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 512,
      "propertyNames": { "$ref": "#/$defs/commandName" }
    },
    "buttons": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9_]{1,32}$": {
          "oneOf": [{ "$ref": "#/$defs/commandName" }, { "type": "null" }]
        }
      }
    },
    "power": { "$ref": "#/$defs/power" },
    "timing": { "$ref": "#/$defs/timing" },
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "steps": { "$ref": "#/$defs/steps" }
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digits": { "type": "integer", "minimum": 1, "maximum": 4 },
        "start": { "$ref": "#/$defs/commandName" },
        "finish": { "$ref": "#/$defs/commandName" }
      }
    },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "allOf": [
    {
      "if": { "properties": { "platform": { "const": "ble_hid" } } },
      "then": {
        "properties": {
          "commands": { "additionalProperties": { "$ref": "#/$defs/bleHidCommand" } },
          "timing": { "not": { "required": ["ir_repeats"] } }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "ir" } } },
      "then": {
        "properties": { "commands": { "additionalProperties": { "$ref": "#/$defs/irCommand" } } }
      }
    }
  ],
  "$defs": {
    "displayName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "commandName": { "type": "string", "pattern": "^[A-Za-z0-9]{1,32}$" },
    "hold_ms": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "label": { "type": "string", "minLength": 1, "maxLength": 32 },
    "bleHidCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "usage"],
      "properties": {
        "page": { "enum": ["keyboard", "consumer"] },
        "usage": { "type": "string" },
        "hold_ms": { "$ref": "#/$defs/hold_ms" },
        "label": { "$ref": "#/$defs/label" }
      },
      "allOf": [
        {
          "if": { "properties": { "page": { "const": "keyboard" } } },
          "then": { "properties": { "usage": { "pattern": "^0x(0[4-9A-F]|[1-5][0-9A-F]|6[0-5])$" } } }
        },
        {
          "if": { "properties": { "page": { "const": "consumer" } } },
          "then": { "properties": { "usage": { "pattern": "^0x0([1-3][0-9A-F]{2}|0[1-9A-F][0-9A-F]|00[1-9A-F])$" } } }
        }
      ]
    },
    "irCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pronto"],
      "properties": {
        "pronto": { "$ref": "#/$defs/pronto" },
        "pronto_toggle": { "$ref": "#/$defs/pronto" },
        "hold_ms": { "$ref": "#/$defs/hold_ms" },
        "label": { "$ref": "#/$defs/label" }
      }
    },
    "pronto": { "type": "string", "pattern": "^0000 [0-9A-F]{4} [0-9A-F]{4} [0-9A-F]{4}( [0-9A-F]{4} [0-9A-F]{4})+$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": { "$ref": "#/$defs/commandName" },
              "hold_ms": { "$ref": "#/$defs/hold_ms" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["delay_ms"],
            "properties": { "delay_ms": { "type": "integer", "minimum": 1, "maximum": 60000 } }
          }
        ]
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["discrete", "toggle", "none"] },
        "on": { "$ref": "#/$defs/steps" },
        "off": { "$ref": "#/$defs/steps" },
        "toggle": { "$ref": "#/$defs/steps" },
        "on_delay_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "discrete" } } },
          "then": { "required": ["on", "off"], "not": { "required": ["toggle"] } }
        },
        {
          "if": { "properties": { "type": { "const": "toggle" } } },
          "then": { "required": ["toggle"], "not": { "anyOf": [{ "required": ["on"] }, { "required": ["off"] }] } }
        },
        {
          "if": { "properties": { "type": { "const": "none" } } },
          "then": { "properties": { "on": false, "off": false, "toggle": false, "on_delay_ms": false } }
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key_delay_ms": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "input_delay_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "ir_repeats": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidence": { "enum": ["high", "medium", "low"] },
        "sources": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
        "notes": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
        "verify": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
        "harmony": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global_device_id": { "type": "integer" },
            "device_type": { "type": "integer" },
            "codeset": { "type": "string" }
          }
        }
      }
    }
  }
}
